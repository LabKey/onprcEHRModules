<query xmlns="http://labkey.org/data/xml/query">
    <metadata>
        <tables xmlns="http://labkey.org/data/xml">
            <table tableName="completionDates" tableDbType="NOT_IN_DB">
                <tableTitle>Employee Completion Dates</tableTitle>

                <columns>
                    <column columnName="snooze_date">
                        <columnTitle>Snooze Until</columnTitle>
                        <formatString>Date</formatString>
                        <isHidden>false</isHidden>
                    </column>
                    <column columnName="requirementname">
                        <columnTitle>Requirement Name</columnTitle>
                        <url>/onprc_ehr_compliancedb/ONPRC/Admin/Compliance/requirementDetails.view?requirementname=${requirementname}</url>
                    </column>
                </columns>
            </table>
        </tables>
    </metadata>
</query>

