<query xmlns="http://labkey.org/data/xml/query">
    <metadata>
        <tables xmlns="http://labkey.org/data/xml">
            <table tableName="" tableDbType="TABLE">
                <tableTitle>Discordant Genotyping Results</tableTitle>
                <columns>
                    <column columnName="results">
                        <url>/query/executeQuery.view?schemaName=geneticscore&amp;
                            query.queryName=mhc_data&amp;
                            query.subjectId~eq=${subjectId}&amp;
                            query.marker~eq=${marker}
                        </url>
                    </column>
                    <column columnName="isDiscordantResult">
                        <columnTitle>Is Discordant Result?</columnTitle>
                    </column>
                </columns>
            </table>
        </tables>
    </metadata>
</query>
