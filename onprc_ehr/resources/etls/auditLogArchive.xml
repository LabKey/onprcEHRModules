<?xml version="1.0" encoding="UTF-8"?>
<etl xmlns="http://labkey.org/etl/xml">
    <name>AuditLogArchive</name>
    <description>Runs Stored Procedure to Archive Audit Logs</description>



    <transforms>
        <transform id="pass Parameter" type="StoredProcedure">
            <procedure schemaName="audit" procedureName="AuditLogArchive" useTransaction="false">
                <parameter name="SourceDB" value="labkey_TestF"/>
            </procedure>
        </transform>
    </transforms>
    <schedule>
        <cronString>0 0 23 * * ?</cronString>
        <enabled>true</enabled>
    </schedule>
</etl>
