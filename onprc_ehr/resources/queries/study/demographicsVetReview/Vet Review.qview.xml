<customView xmlns="http://labkey.org/data/xml/queryCustomView" hidden="true">
    <columns>
        <column name="Id/clinicalActions"/>
        <column name="Id"/>
        <column name="room"/>
        <column name="cage"/>
        <column name="Hx"/>
        <column name="Remarks">
            <properties>
                <property name="columnTitle" value="Remarks Entered Since Last Vet Review"/>
            </properties>
        </column>
        <column name="Recent Observations">
            <properties>
                <property name="columnTitle" value="Latest Observations"/>
            </properties>
        </column>
        <column name="Recent Observation Date"/>
        <column name="VomitObservations">
            <properties>
                <property name="columnTitle" value="Vomit Observations"/>
            </properties>
        </column>
        <column name="vomitObservationsdate">
            <properties>
                <property name="columnTitle" value="Vomit Observations Date"/>
            </properties>
        </column>
        <column name="lastVetReview"/>
        <column name="Id/utilization/use"/>
        <column name="Id/activeCases/categories">
            <properties>
                <property name="columnTitle" value="Active Cases"/>
            </properties>
        </column>

        <column name="Status">
            <properties>
                <property name="columnTitle" value="Status"/>
            </properties>
        </column>
    </columns>
    <sorts>
        <sort column="Id/curLocation/room"/>
        <sort column="Id/curLocation/cage"/>
        <sort column="Id" />
        <sort column="date" />
    </sorts>
</customView>