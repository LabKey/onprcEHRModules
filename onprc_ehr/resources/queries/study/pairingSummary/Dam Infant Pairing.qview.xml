<customView xmlns="http://labkey.org/data/xml/queryCustomView">
    <columns>
        <column name="Id"/>
        <column name="infant_id"/>
        <column name="lowestCage"/>
        <column name="Id/demographics/gender"/>
        <column name="otherIDs"/>
        <column name="other_infant"/>
        <column name="date"/>
        <column name="eventtype"/>
        <column name="category"/>
        <column name="remark"/>
        <column name="goal"/>
        <column name="outcome"/>
        <column name="enddate"/>
        <column name="endeventType"/>
        <column name="separationreason"/>
        <column name="housingtype"/>
        <column name="observation"/>
        <column name="duration"/>
        <column name="remark2"/>
        <column name="performedby"/>
        <column name="taskid"/>
        <!--<column name="history"/>-->
    </columns>
    <filters>
        <filter column="eventtype" operator="in" value="Lactating foster;Nonlactating foster;C-sx reunite;Bio dam reunite"/>
    </filters>

    <sorts>
        <sort column="date" descending="true"/>
    </sorts>

</customView>
